# ==============================================================================
# METEO-GIS / NER LANDSLIDE RISKWATCH — ENVIRONMENT CONFIGURATION TEMPLATE
# Add these variables to your Vercel Project Settings -> Environment Variables
# ==============================================================================

# Mode: "LIVE" (streams from live external APIs) or "DEMO" (calibrated fallback)
SYSTEM_MODE=LIVE
NEXT_PUBLIC_SYSTEM_MODE=LIVE

# 1. ISRO Bhuvan Geospatial Services
BHUVAN_TOKEN=your_bhuvan_token_here
NEXT_PUBLIC_BHUVAN_TOKEN=your_bhuvan_token_here

# 2. India Meteorological Department (IMD)
IMD_API_KEY=your_imd_api_key_here
NEXT_PUBLIC_IMD_API_KEY=your_imd_api_key_here
IMD_EMAIL=your_imd_email_here
IMD_PASSWORD=your_imd_password_here

# 3. NASA POWER & Earthdata
NASA_POWER_API_KEY=
NEXT_PUBLIC_NASA_POWER_API_KEY=
EARTHDATA_BEARER_TOKEN=

# 4. Copernicus Data Space Ecosystem (Sentinel-1 & Sentinel-2)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# 5. Routing Services
GRAPHHOPPER_API_KEY=your_graphhopper_api_key_here
NEXT_PUBLIC_GRAPHHOPPER_API_KEY=your_graphhopper_api_key_here
DATABASE_URL=
