# =============================================================================
# NER Landslide RiskWatch — Backend Environment
# Copy to `.env` and adjust. All values have working defaults except DATABASE_URL.
# =============================================================================

# --- PostGIS database (required for live data; app falls back to static data if unreachable) ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ner_landslide

# --- Upstream geospatial providers (optional; hardcoded fallbacks exist) ---
BHUVAN_TOKEN=
IMD_API_KEY=
NASA_POWER_API_KEY=
COPERNICUS_CLIENT_ID=
GRAPHHOPPER_API_KEY=

# --- System mode (LIVE | SIMULATION) ---
SYSTEM_MODE=LIVE
